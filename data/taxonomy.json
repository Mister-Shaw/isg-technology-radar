      "name": "国产 GPU",
      "layer": "芯片与加速卡",
      "include": [
        "国产GPU",
        "海光DCU",
        "GPGPU",
        "智算加速卡"
      ],
      "context_required": "明确国产GPU/DCU产品与采购；CPU和NPU另设芯片标签，不自动归入GPU",
      "exclude": [
        "只有海光CPU",
        "只有鲲鹏CPU",
        "GPU品牌未明示"
      ],
      "proof_metrics": []
    },
    {
      "id": "compute_field",
      "name": "算力场",
      "layer": "资源池、调度与一体机部署",
      "include": [
        "算力场",
        "算力资源池",
        "算力网",
        "算力互联网",
        "统一调度",
        "异构调度",
        "AI一体机采购",
        "大模型一体机部署"
      ],
      "context_required": "算力资源池及统一调度平台，含算力互联网/算力网；按2026-09-20确认的新口径，亦纳入AI/大模型一体机采购与部署，区分一体机与资源池/调度项目。",
      "exclude": [
        "只有机房建设",
        "普通单台服务器且无AI一体机或资源池/调度用途",
        "只有一体机概念宣传，无采购或部署证据"
      ],
      "proof_metrics": []
    },
    {
      "id": "eda",
      "name": "EDA",
      "layer": "应用负载与研发工具",
      "include": [
