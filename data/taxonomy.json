        "算力租赁",
        "算力服务",
        "GPU租赁",
        "卡时"
      ],
      "context_required": "租赁算力资源或卡时服务，区分服务期限、总价和单位价格",
      "exclude": [
        "单纯设备买断",
        "只有未签约报价"
      ],
      "proof_metrics": []
    },
    {
      "id": "token_factory",
      "name": "Token 工厂",
      "layer": "运营与商业模式",
      "include": [
        "词元工厂",
        "Token工厂",
        "AI工厂",
        "推理工厂"
