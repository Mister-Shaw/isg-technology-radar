      "context_required": "电子设计自动化的工具、仿真及算力基础设施；许可与硬件金额分开",
      "exclude": [
        "移动护理EDA终端",
        "与芯片设计无关的同名缩写"
      ],
      "proof_metrics": []
    },
    {
      "id": "compute_rental",
      "name": "算力租赁",
