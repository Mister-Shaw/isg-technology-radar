      "exclude": [
        "泛称模块化的软件",
        "单独机柜配件"
      ],
      "proof_metrics": []
    },
    {
      "id": "xpu",
      "name": "xPU / 异构加速",
      "layer": "处理器与异构计算",
      "include": [
        "xPU",
        "异构计算",
        "异构算力",
        "异构加速",
        "NPU",
        "DPU",
        "FPGA",
        "专用加速器"
      ],
      "context_required": "显式xPU/异构方案，或服务器、数据中心场景的其他加速器；单独CPU/GPU不自动归入；历史仅重识别已有资料，尚未专项补采。",
      "exclude": [
        "消费终端与车载",
        "仅普通CPU/GPU词汇",
        "无算力基础设施语境的FPGA/NPU/DPU"
      ],
      "proof_metrics": []
    }
  ],
  "rules": [
    "观察主题可重叠，禁止把跨类别金额或项目数相加为市场规模。",
    "关键词仅发现候选；须核对原文、买方、时间、地域、阶段和金额口径。",
    "海光CPU、海光DCU、鲲鹏CPU、昇腾NPU及未确定芯片分别标注。"
  ]
}
