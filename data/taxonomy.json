{
  "version": "3.0",
  "geography": "中国大陆",
  "technologies": [
    {
      "id": "supernode",
      "name": "超节点",
      "layer": "系统与互连架构",
      "include": [
        "超节点",
        "超结点",
        "SuperPod",
        "scale-up"
      ],
      "context_required": "机柜或多柜内高速互连、统一资源域及具体系统配置，不能仅因集群规模大就纳入",
      "exclude": [
        "普通scale-out集群",
        "区块链超级节点"
      ],
      "proof_metrics": [
        "独立采购/投产客户",
        "有效训练/推理吞吐",
        "互连效率",
        "利用率",
        "系统交付周期"
      ]
    },
    {
      "id": "liquid_cooling",
      "name": "液冷",
      "layer": "热管理与交付基础设施",
      "include": [
        "液冷",
        "冷板",
        "浸没式",
        "CDU"
      ],
      "context_required": "服务器/机柜/智算中心，区分冷板、浸没、两相及设施侧",
      "exclude": [
        "消费PC水冷",
        "空调单独采购",
        "标题液冷但正文标的不符"
      ],
      "proof_metrics": [
        "液冷采购客户",
        "投产机柜",
        "实测PUE/WUE及测量边界",
        "泄漏/停机事件",
        "改造总成本"
      ]
    },
    {
