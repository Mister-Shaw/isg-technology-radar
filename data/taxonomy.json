      "layer": "光互连架构",
      "include": [
        "光交换机",
        "全光交换",
        "OCS",
        "光路交换"
      ],
      "context_required": "明确光路交换OCS技术或产品，厂商海外发布只表明供给进展",
      "exclude": [
        "普通以太网交换机",
        "光模块单品",
        "光纤收发器"
      ],
      "proof_metrics": []
    },
    {
      "id": "ai_storage",
      "name": "AI 存储",
      "layer": "数据与存储",
      "include": [
        "AI存储",
        "智算存储",
        "高性能并行存储",
        "Checkpoint",
        "缓存文件存储"
      ],
      "context_required": "明确服务训练/推理/AI数据处理的存储采购或技术",
      "exclude": [
        "普通办公存储",
        "没有AI场景的通用NAS"
      ],
      "proof_metrics": []
    },
    {
      "id": "aidc",
      "name": "AIDC",
      "layer": "智算中心基础设施",
      "include": [
        "AIDC",
        "智算中心",
        "人工智能数据中心"
      ],
      "context_required": "AI数据中心的规划、建设与运营，分开项目总投资和IT设备额",
      "exclude": [
        "仅传统机房且无AI负载"
      ],
      "proof_metrics": []
    },
    {
      "id": "modular_dc",
      "name": "模块化数据中心",
      "layer": "交付与建设形态",
      "include": [
